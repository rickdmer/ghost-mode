<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ghost Mode" Width="392" Height="704"
        ResizeMode="CanMinimize" WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="#313338" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="#DBDEE1">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="BgTertiary" Color="#1E1F22" />
    <SolidColorBrush x:Key="BgSecondary" Color="#2B2D31" />
    <SolidColorBrush x:Key="BgHover" Color="#35373C" />
    <SolidColorBrush x:Key="TextMuted" Color="#949BA4" />
    <SolidColorBrush x:Key="TextHeader" Color="#F2F3F5" />
    <SolidColorBrush x:Key="Blurple" Color="#5865F2" />
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Title bar buttons -->
    <Style x:Key="TitleButton" TargetType="Button">
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Foreground" Value="#B5BAC1" />
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#2E3035" />
                <Setter Property="Foreground" Value="#F2F3F5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#DA373C" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Big action button; colour comes from Background -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="8" />
              <Border x:Name="shade" Background="Black" Opacity="0" CornerRadius="8" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="shade" Property="Opacity" Value="0.12" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="shade" Property="Opacity" Value="0.22" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Small text button (Check status) -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="#B5BAC1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="8,4">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#393C41" />
                <Setter Property="Foreground" Value="#F2F3F5" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Status line under each app: clickable, opens the per-app status menu -->
    <Style x:Key="StatusButton" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="4,1" Margin="-4,0,0,0">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#393C41" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Discord-style toggle switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="40" Height="24" Background="Transparent">
              <Border x:Name="track" CornerRadius="12" Background="#80848E" />
              <Ellipse x:Name="thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#23A55A" />
                <Setter TargetName="thumb" Property="Margin" Value="19,0,0,0" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One row in the settings flyout / first-run card -->
    <DataTemplate x:Key="OptionTemplate">
      <Grid Margin="0,7">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,14,0">
          <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#F2F3F5" />
          <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{Binding DetailBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding IsOn}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Dark context menu -->
    <Style TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="#111214" CornerRadius="6" Padding="6" BorderBrush="#2B2D31" BorderThickness="1">
              <StackPanel IsItemsHost="True" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Foreground" Value="#DBDEE1" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="bg" Background="Transparent" CornerRadius="3" Padding="8,7" MinWidth="170">
              <StackPanel Orientation="Horizontal">
                <ContentPresenter ContentSource="Icon" Margin="0,0,10,0" VerticalAlignment="Center" />
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#5865F2" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim scrollbar -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="MinWidth" Value="8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#1A1B1E" CornerRadius="4" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Grid Background="{StaticResource BgTertiary}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
        <Image x:Name="TitleIcon" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="Ghost Mode" Margin="8,0,0,1" FontSize="13" FontWeight="SemiBold" Foreground="#B5BAC1" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="SettingsButton" Style="{StaticResource TitleButton}" Content="&#xE713;" FontSize="13" ToolTip="Settings" />
        <Button x:Name="MinimizeButton" Style="{StaticResource TitleButton}" Content="&#xE921;" ToolTip="Minimize" />
        <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close" />
      </StackPanel>
    </Grid>

    <!-- Hero: overall state + main action -->
    <Border Grid.Row="1" Background="{StaticResource BgSecondary}" CornerRadius="12" Margin="16,16,16,0" Padding="18">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Width="56" Height="56" VerticalAlignment="Center">
            <Image x:Name="HeroIcon" RenderOptions.BitmapScalingMode="HighQuality" />
          </Grid>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Headline}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextHeader}"
                       FontFamily="Segoe UI Variable Display, Segoe UI" />
            <TextBlock Text="{Binding Subline}" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
        <Button Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Command="{Binding ToggleCommand}" Background="{Binding PrimaryBrush}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding PrimaryGlyph}" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="{Binding PrimaryText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Text="{Binding HotkeyHint}" Visibility="{Binding HotkeyHintVisibility}" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12" Foreground="#80848E" />
      </StackPanel>
    </Border>

    <!-- Section header -->
    <Grid Grid.Row="2" Margin="20,20,14,6">
      <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}">
        <Run Text="APPS" /><Run Text=" &#x2014; " /><Run Text="{Binding IncludedSummary, Mode=OneWay}" />
      </TextBlock>
      <Button HorizontalAlignment="Right" Style="{StaticResource LinkButton}" Command="{Binding RefreshCommand}"
              ToolTip="Briefly opens apps whose status can't be read in the background (Xbox, and Battle.net / GOG when they're in the tray)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,1,6,0" />
          <TextBlock Text="Check status" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- App list (generated from ProviderRegistry) -->
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="16,0,8,0" Padding="0,0,8,0">
      <ItemsControl x:Name="AppList" ItemsSource="{Binding Apps}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="card" Background="{StaticResource BgSecondary}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App icon with presence badge -->
                <Grid Width="40" Height="40" VerticalAlignment="Center" Opacity="{Binding ContentOpacity}">
                  <Border CornerRadius="10" Background="#232428">
                    <Image Source="{Binding Icon}" Margin="6" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Border>
                  <TextBlock Text="{Binding Initial}" Visibility="{Binding InitialVisibility}" FontSize="18" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextHeader}" />
                  <Grid Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Visibility="{Binding BadgeVisibility}">
                    <Ellipse Fill="{Binding Background, ElementName=card}" />
                    <Ellipse Margin="3" Fill="{Binding StateBrush}" />
                    <Ellipse Margin="6" Fill="{Binding Background, ElementName=card}" Visibility="{Binding RingVisibility}" />
                  </Grid>
                </Grid>

                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Opacity="{Binding ContentOpacity}">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextHeader}" />
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#6D6F78" Margin="7,2,0,0"
                               VerticalAlignment="Center" Visibility="{Binding CaveatVisibility}" ToolTip="{Binding Caveat}" Background="Transparent" />
                  </StackPanel>
                  <Button Style="{StaticResource StatusButton}" Tag="status" IsEnabled="{Binding CanSetIndividually}" Margin="0,2,0,0"
                          ToolTip="Set just this app">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Online" Command="{Binding SetOnlineCommand}">
                          <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="#23A55A" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Invisible" Command="{Binding SetInvisibleCommand}">
                          <MenuItem.Icon><Grid Width="10" Height="10"><Ellipse Fill="#80848E" /><Ellipse Margin="3" Fill="#111214" /></Grid></MenuItem.Icon>
                        </MenuItem>
                      </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{Binding SubtitleBrush}" TextTrimming="CharacterEllipsis" MaxWidth="215" />
                      <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,2,0,0" VerticalAlignment="Center"
                                 Foreground="{StaticResource TextMuted}" Visibility="{Binding ChevronVisibility}" />
                    </StackPanel>
                  </Button>                </StackPanel>

                <Grid Grid.Column="2" VerticalAlignment="Center">
                  <ProgressBar IsIndeterminate="True" Width="40" Height="3" Visibility="{Binding BusyVisibility}"
                               Foreground="{StaticResource Blurple}" Background="Transparent" BorderThickness="0" />
                  <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Included}" IsEnabled="{Binding IsAvailable}"
                            Visibility="{Binding SwitchVisibility}" ToolTip="{Binding SwitchTooltip}" />
                </Grid>
              </Grid>
            </Border>
            <DataTemplate.Triggers>
              <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                <Setter TargetName="card" Property="Background" Value="{StaticResource BgHover}" />
              </Trigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Settings flyout (opened from the gear) -->
    <Popup x:Name="SettingsPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade"
           PlacementTarget="{Binding ElementName=SettingsButton}" HorizontalOffset="-182" VerticalOffset="2">
      <Border Background="#111214" CornerRadius="8" BorderBrush="#2B2D31" BorderThickness="1" Padding="16,10,16,8" Width="310" Margin="0,0,8,8">
        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" /></Border.Effect>
        <StackPanel>
          <TextBlock Text="SETTINGS" FontSize="12" FontWeight="Bold" Foreground="#949BA4" Margin="0,2,0,2" />
          <ItemsControl ItemsSource="{Binding Options}" ItemTemplate="{StaticResource OptionTemplate}" />
          <Border Height="1" Background="#2B2D31" Margin="0,6,0,8" />
          <TextBlock x:Name="VersionText" FontSize="11" Foreground="#6D6F78" Margin="0,0,0,2" />
        </StackPanel>
      </Border>
    </Popup>

    <!-- First-run card -->
    <Grid Grid.Row="1" Grid.RowSpan="4" Panel.ZIndex="10" Visibility="{Binding SetupVisibility}">
      <Border Background="Black" Opacity="0.65" />
      <Border Background="#313338" CornerRadius="12" Margin="20,0" VerticalAlignment="Center" Padding="22,20" BorderBrush="#3F4147" BorderThickness="1">
        <StackPanel>
          <Image x:Name="SetupIcon" Width="52" Height="52" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="Welcome to Ghost Mode" FontSize="20" FontWeight="Bold" Foreground="#F2F3F5" Margin="0,12,0,0"
                     FontFamily="Segoe UI Variable Display, Segoe UI" />
          <TextBlock FontSize="13" Foreground="#B5BAC1" TextWrapping="Wrap" Margin="0,4,0,10"
                     Text="Turn on any extras you'd like. Nothing is added unless you switch it on, and you can change these later from the gear at the top." />
          <ItemsControl ItemsSource="{Binding Options}" ItemTemplate="{StaticResource OptionTemplate}" />
          <Button Style="{StaticResource PrimaryButton}" Background="#5865F2" Margin="0,14,0,0" Command="{Binding FinishSetupCommand}" Content="Done" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="4" Background="#2B2D31" Padding="16,9">
      <TextBlock Text="{Binding Footer}" FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
